---
interface Link {
  href: string;
  label: string;
  external?: boolean;
  match?: (path: string) => boolean;
}

interface Props {
  links: Link[];
  path: string;
  prominent?: boolean;
}

const { links, path, prominent = false } = Astro.props;
---

{
  links.map((link) => {
    const external = link.external === true;
    const active = !external && link.match?.(path) === true;
    return (
      <li>
        <a
          href={link.href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
          class:list={[prominent && 'font-medium', prominent && active && 'bg-base-200']}
          aria-current={active ? 'page' : undefined}
        >
          {link.label}
        </a>
      </li>
    );
  })
}
